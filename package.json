{
  "name": "screen-translator",
  "version": "0.2.1",
  "description": "Astra plugin: translate on-screen text — region hotkey, live subtitles, Windows OCR",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun install --frozen-lockfile && esbuild src/index.ts --bundle --platform=node --format=cjs --loader:.ps1=text --outfile=dist/index.js",
    "pretest": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:astra-plugin-sdk --loader:.ps1=text --outfile=test/.build/plugin.cjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "astra-plugin-sdk": "^0.7.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "author": "Taill",
  "license": "MIT",
  "private": true
}